{
  "name": "ai-ivr-jev",
  "version": "1.0.0",
  "description": "Twilio ConversationRelay + TypeSafe AI (Jev) + OpenAI hybrid low-latency voice IVR server",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@ngrok/ngrok": "^1.7.0",
    "@twilio/voice-sdk": "^2.18.5",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "openai": "^7.20.0",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
