# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Honor X-Forwarded-* headers (ngrok / load balancer)
TRUST_PROXY=true
# Public hostname Twilio reaches this server on. No scheme, no path.
# Leave empty when NGROK_ENABLED=true (the tunnel's hostname is used).
PUBLIC_HOST=

# ---- Built-in ngrok tunnel (local development) ----
# true: open a tunnel on startup, close it on shutdown, and use its URL as the public host.
NGROK_ENABLED=false
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved/static domain (e.g. your-name.ngrok.app) so the URL stays the same between runs.
NGROK_DOMAIN=
# After the tunnel is up, set VoiceUrl=https://<tunnel>/twiml on TWILIO_TWIML_APP_SID (and
# TWILIO_PHONE_NUMBER_SID if set). Uses the API key below, or TWILIO_AUTH_TOKEN.
TWILIO_SYNC_WEBHOOKS=true
# Optional: also repoint this incoming phone number (PNxxxxxxxx…).
TWILIO_PHONE_NUMBER_SID=

# ---- TypeSafe AI (Jev) ----
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
# Hard deadline per turn (shared across retries). On timeout the turn degrades to a re-ask.
JEV_TIMEOUT_MS=1500
JEV_MAX_RETRIES=1

# ---- OpenAI (FAQ deep path only) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
FAQ_MAX_CHARS=100
# After triage, add an LLM remark about the trouble (a check to do now / first aid / reassurance) before asking for a date.
TRIAGE_ADVICE=true
ADVICE_MAX_CHARS=60

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set in production: enables X-Twilio-Signature verification on /twiml* and the WebSocket upgrade.
TWILIO_AUTH_TOKEN=
# E.164 number to <Dial> on human handoff. Empty = apologize and hang up.
HANDOFF_PHONE_NUMBER=
# Caller ID for the handoff <Dial>. Needed for browser calls (their From is "client:…"); use a Twilio number you own.
HANDOFF_CALLER_ID=

# ---- Browser phone (optional; https://<PUBLIC_HOST>/phone) ----
# Enabled only when all three are set.
# API key: Console > Account > API keys & tokens (Standard key)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App: Console > Voice > TwiML Apps. Set its Voice Request URL to https://<PUBLIC_HOST>/twiml (POST)
TWILIO_TWIML_APP_SID=
# Shared passcode (8+ chars) for getting a call token. Required when NODE_ENV=production.
BROWSER_PHONE_PASSCODE=
BROWSER_PHONE_TOKEN_TTL_SEC=3600
BROWSER_PHONE_TOKEN_RATE_LIMIT_MAX=10

# ---- Decision policy ----
CONFIDENCE_THRESHOLD=0.65
REQUIRES_HUMAN_THRESHOLD=0.7
# Minimum Noul for "the utterance answers the slot we asked for" (date, name, number)
SLOT_THRESHOLD=0.6
# Minimum Noul for "this is an emergency" (water won't stop, flooding, gas smell)
EMERGENCY_THRESHOLD=0.7
MAX_CLARIFY_FAILURES=2
# While an FAQ answer is generating, utterances shorter than this (「はい」etc.) don't cancel it.
FAQ_BARGE_IN_MIN_CHARS=8

# ---- Voice (optional; Twilio defaults apply when empty) ----
TTS_LANGUAGE=ja-JP
# Twilio's default (ElevenLabs) misreads Japanese kanji; a native ja-JP voice is recommended.
# Google: ja-JP-Neural2-B / ja-JP-Wavenet-B …   Amazon: Kazuha-Neural / Takumi-Neural / Tomoko-Neural
TTS_PROVIDER=Google
TTS_VOICE=ja-JP-Neural2-B
TRANSCRIPTION_PROVIDER=
SPEECH_MODEL=

# ---- Rate limiting (per IP) ----
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
